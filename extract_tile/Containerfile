FROM python:3.12-slim

COPY ./extract_tile/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Bake the DuckDB S3 extensions into the image so jobs do not download them at run time
ENV DUCKDB_EXTENSION_DIR=/opt/duckdb_extensions
RUN mkdir -p $DUCKDB_EXTENSION_DIR \
    && python -c "import duckdb; c = duckdb.connect(); c.sql(\"SET extension_directory='/opt/duckdb_extensions'\"); c.sql('INSTALL httpfs'); c.sql('INSTALL aws')" \
    && chmod -R a+rX $DUCKDB_EXTENSION_DIR

# The growing-season windows are versioned with the code
COPY ./extract_tile/doy_windows.csv /app/doy_windows.csv
ENV GEDI_PA_WINDOWS=/app/doy_windows.csv

# Drift correction and L4A V3 models (see correction.py)
COPY ./extract_tile/correction.py /usr/local/bin/correction.py
COPY ./extract_tile/l4a_model_data.json ./extract_tile/l4a_overrides.json ./extract_tile/drift_correction.csv /app/
ENV GEDI_PA_L4A_MODELS=/app/l4a_model_data.json \
    GEDI_PA_L4A_OVERRIDES=/app/l4a_overrides.json \
    GEDI_PA_DRIFT=/app/drift_correction.csv

COPY ./extract_tile/extract_tile.py /usr/local/bin/extract_tile.py
RUN chmod +x /usr/local/bin/extract_tile.py
