# Veronika Leitold's Brazil V3 matching (step 4) for DPS. Build context is the repo root.
# rocker/geospatial pins R and CRAN (Posit Package Manager snapshot) per tag, so package
# versions are fixed for a given tag; it already has terra, sf, dplyr, tidyr, stringr, purrr.
FROM rocker/geospatial:4.4.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-boto3 \
    && rm -rf /var/lib/apt/lists/*

RUN install2.r --error --skipinstalled optmatch foreach doParallel data.table \
    && Rscript -e 'for (p in c("terra", "sf", "dplyr", "tidyr", "stringr", "purrr", "optmatch", "foreach", "doParallel", "data.table")) library(p, character.only = TRUE)'

COPY ./matching/r/brazil_v3/gedi_change_step4_V3_cmd.R ./matching/r/brazil_v3/matching_func_2025.R /app/
COPY ./matching/dps/run_matching.sh ./matching/dps/s3_get.py /app/
RUN chmod +x /app/run_matching.sh /app/s3_get.py \
    && ln -s /app/run_matching.sh /usr/local/bin/run_matching.sh
